# Copy to .env for local development:  copy .env.example .env   (never commit .env)
# Real environment variables always override values in .env.
# Optional per-environment overrides: environments/<APP_ENV>.env

# ---------------------------------------------------------------- APP_
# development | test | production
APP_ENV=development
APP_NAME=Tech-Toppings API
APP_VERSION=0.1.0
# Interactive docs at /docs and schema at /openapi.json
APP_DOCS_ENABLED=true

# ---------------------------------------------------------------- MONGO_
# Full connection string INCLUDING the database name.
# Local:  mongodb://localhost:27017/tech-toppings-v1
# Atlas:  mongodb+srv://<user>:<password>@<cluster-host>/tech-toppings-v1?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/tech-toppings-v1
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=0
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_APP_NAME=tech-toppings-api

# ---------------------------------------------------------------- LOG_
LOG_LEVEL=INFO
# json (production) | console (readable, local)
LOG_FORMAT=console
# Comma-separated key fragments whose values are masked in logs (defaults shown).
LOG_REDACT_KEYS=password,secret,token,authorization,cookie,transcript,email,totp,sms,uri
# Successful requests to these paths are logged at DEBUG.
LOG_QUIET_PATHS=/healthz,/readyz

# ---------------------------------------------------------------- CORS_
# Comma-separated origins allowed to call the API cross-origin. Leave empty when the
# frontend reaches the API through its same-origin /api proxy (dev server and production).
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------- SECURITY_
# Strict-Transport-Security max-age in seconds; 0 = off (local http). Production: 31536000.
SECURITY_HSTS_MAX_AGE_SECONDS=0

# ---------------------------------------------------------------- server (uvicorn)
# Read by `poe dev` and the Docker image. Render injects PORT automatically.
HOST=127.0.0.1
PORT=8000
# Proxies whose X-Forwarded-* headers uvicorn trusts (Render: "*").
FORWARDED_ALLOW_IPS=127.0.0.1

# ---------------------------------------------------------------- tests
# MongoDB server used by the test suite (a throwaway database is created and dropped).
TEST_MONGO_URI=mongodb://localhost:27017
