# Copy to .env for local development:  copy .env.example .env   (never commit .env)
# Real environment variables always override values in .env.
# Optional per-environment overrides: environments/<APP_ENV>.env

# ---------------------------------------------------------------- APP_
# development | test | production
APP_ENV=development
APP_NAME=Tech-Toppings API
APP_VERSION=0.1.0
# Interactive docs at /docs and schema at /openapi.json
APP_DOCS_ENABLED=true
# Timeout (seconds) for outbound HTTP calls, e.g. fetching Google sign-in keys.
APP_HTTP_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------- MONGO_
# Full connection string INCLUDING the database name.
# Local:  mongodb://localhost:27017/tech-toppings-v1
# Atlas:  mongodb+srv://<user>:<password>@<cluster-host>/tech-toppings-v1?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/tech-toppings-v1
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=0
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_APP_NAME=tech-toppings-api

# ---------------------------------------------------------------- LOG_
LOG_LEVEL=INFO
# json (production) | console (readable, local)
LOG_FORMAT=console
# Comma-separated key fragments whose values are masked in logs (defaults shown).
LOG_REDACT_KEYS=password,secret,token,authorization,cookie,transcript,email,totp,sms,uri
# Successful requests to these paths are logged at DEBUG.
LOG_QUIET_PATHS=/healthz,/readyz

# ---------------------------------------------------------------- CORS_
# Comma-separated origins allowed to call the API cross-origin. Leave empty when the
# frontend reaches the API through its same-origin /api proxy (dev server and production).
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------- SECURITY_
# Strict-Transport-Security max-age in seconds; 0 = off (local http). Production: 31536000.
SECURITY_HSTS_MAX_AGE_SECONDS=0
# Shared with the frontend's /api proxy (the Cloudflare Pages Function, its API_PROXY_SECRET),
# which sends it in SECURITY_PROXY_HEADER (ADR-0019). Set, the API answers nothing that lacks
# it but SECURITY_PROXY_EXEMPT_PATHS (the host's health check), so nobody reaches it around the
# proxy, and the client address the proxy passes on can be trusted (FORWARDED_ALLOW_IPS=*).
# Empty = answer anyone (local development). Required with APP_ENV=production. 32+ printable
# ASCII characters, no spaces; generate one with:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(48))"
SECURITY_PROXY_SECRET=
SECURITY_PROXY_HEADER=X-TT-Proxy
SECURITY_PROXY_EXEMPT_PATHS=/healthz
# With APP_ENV=production the server refuses to start unless: HSTS is above 0, the proxy
# secret is set, AUTH_REFRESH_COOKIE_SECURE=true, APP_DOCS_ENABLED=false, LOG_FORMAT=json,
# RATE_LIMIT_ENABLED=true and CORS_ALLOWED_ORIGINS lists only https:// origins.

# ---------------------------------------------------------------- AUTH_
# REQUIRED. Access-token signing key (32+ characters). Generate one with:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=change-me-to-a-long-random-value-from-the-command-above
AUTH_JWT_ISSUER=tech-toppings-api
AUTH_JWT_AUDIENCE=tech-toppings-web
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# Refresh sessions slide forward on use (30 days) but end after 90 days regardless.
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_REFRESH_ABSOLUTE_TTL_SECONDS=7776000
# A just-replaced refresh token presented within this window = two tabs racing (409), not theft.
AUTH_REFRESH_REUSE_GRACE_SECONDS=10
AUTH_REFRESH_COOKIE_NAME=tt_refresh
# Path as the BROWSER sees it (through the same-origin /api proxy).
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
# true everywhere except plain-http setups that don't use localhost.
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAMESITE=strict
AUTH_CSRF_HEADER=X-TT-CSRF
# open | allowlist | closed. Allowlist: only these (comma-separated) emails, and those an admin
# adds in the console (/v1/admin/allowed-emails), can register. BOOTSTRAP_ADMIN_EMAIL always can.
AUTH_REGISTRATION_MODE=allowlist
AUTH_ALLOWED_EMAILS=
AUTH_PASSWORD_MIN_LENGTH=10
AUTH_PASSWORD_MAX_LENGTH=128
# Required character classes out of lowercase / uppercase / digit / symbol.
AUTH_PASSWORD_MIN_CLASSES=2
# Failed sign-ins before the account locks; the lock doubles each further failure.
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_BASE_SECONDS=60
AUTH_LOCKOUT_MAX_SECONDS=3600
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_PARALLELISM=1
# Optional "Sign in with Google": set the OAuth *web* client id to enable (no secret needed).
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
AUTH_GOOGLE_ISSUERS=accounts.google.com,https://accounts.google.com
AUTH_GOOGLE_JWKS_CACHE_SECONDS=3600
# TOTP 2FA: the key that encrypts each user's secret at rest (Fernet, 32 bytes url-safe base64).
# Empty = 2FA can't be turned on. Generate one with:
#   .venv\Scripts\python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AUTH_FIELD_ENCRYPTION_KEY=
AUTH_TOTP_ISSUER=Tech-Toppings
AUTH_TOTP_WINDOW_STEPS=1
AUTH_TOTP_CHALLENGE_SECONDS=300
AUTH_RECOVERY_CODES=10
# An account without a password proves it's them with a Google sign-in this fresh (turning 2FA
# on or off, deleting the account, setting a first password).
AUTH_GOOGLE_REAUTH_MAX_AGE_SECONDS=300
# Ended sessions (device, IP) are kept this many days past their end, to catch a stolen token.
AUTH_SESSION_PURGE_GRACE_DAYS=7

# ---------------------------------------------------------------- RATE_LIMIT_
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=async+memory://
RATE_LIMIT_AUTH_LOGIN=10/minute
RATE_LIMIT_AUTH_REGISTER=5/minute
RATE_LIMIT_AUTH_REFRESH=60/minute
RATE_LIMIT_AUTH_PASSWORD_CHANGE=10/minute
RATE_LIMIT_AGENT_RUN=20/minute
RATE_LIMIT_JOBS_RUN=30/minute
RATE_LIMIT_SEARCH=120/minute
RATE_LIMIT_EXPORT=10/minute
RATE_LIMIT_IMPORTS=60/minute
# Subscribing a browser to pushes, or sending oneself a test push.
RATE_LIMIT_PUSH=10/minute

# ---------------------------------------------------------------- API_
API_DEFAULT_PAGE_SIZE=20
API_MAX_PAGE_SIZE=100
# Largest request body (bytes) any route takes; bigger is refused (413 REQUEST_TOO_LARGE). It
# must fit the CSV import's largest file base64-encoded (a third bigger) with its mapping.
API_MAX_BODY_BYTES=3000000
# Answers this many bytes or more are gzipped for callers that accept it (0 = never). Render's
# free plan counts every byte the API sends (5 GB a month, docs/free-tier-limits.md).
API_GZIP_MIN_BYTES=1000
# Never gzipped (comma-separated path prefixes): sign-in answers hold a token, and compressed
# next to what the caller sent, its length could give it away (BREACH).
API_GZIP_SKIP_PATHS=/v1/auth

# ---------------------------------------------------------------- DEFAULT_ (new accounts)
# en | ta | hi
DEFAULT_LOCALE=en
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------- MODULES_
# Comma-separated packages whose sub-folders (with a manifest.py) are feature modules.
MODULES_PACKAGES=app.modules
# Seconds a module's Welcome-tile figure may take before the tile shows without it.
MODULES_TILE_STAT_TIMEOUT_SECONDS=2.0

# ---------------------------------------------------------------- AGENT_ (ADR-0013)
# agent = an AI agent runs skills; static = each skill's deterministic script, no AI at all.
AGENT_MODE=agent
# When AI can't run (no consent, quota used up, provider down): true = use the static script,
# false = answer honestly that AI is unavailable.
AGENT_FALLBACK=true
# Per-skill overrides, e.g. manage-modules=static
AGENT_SKILL_MODES=
# Free OpenAI-compatible providers, tried in order (JSON). Leave [] to run without AI.
# "vision": true marks one whose model reads images: receipt photos go only to those (ADR-0021).
# Examples (free tiers; get your own key, never commit it):
#   [{"name":"gemini","base_url":"https://generativelanguage.googleapis.com/v1beta/openai","model":"<model>","api_key":"<key>","vision":true},
#    {"name":"groq","base_url":"https://api.groq.com/openai/v1","model":"<model>","api_key":"<key>"},
#    {"name":"ollama","base_url":"http://localhost:11434/v1","model":"<model>"}]
AGENT_PROVIDERS=[]
AGENT_PROVIDER_COOLDOWN_SECONDS=60
# AI calls per user per day, and for the whole app per day (0 switches AI off).
AGENT_USER_DAILY_CALLS=30
AGENT_GLOBAL_DAILY_CALLS=800
AGENT_MAX_STEPS=6
AGENT_MAX_INPUT_CHARS=1000
# Text read from a receipt photo on the device: longer than anything typed.
AGENT_MAX_OCR_CHARS=4000
# A receipt photo for a vision provider (the app shrinks it to some 300 KB first): held in
# memory for the run, never stored; at most API_MAX_BODY_BYTES (checked at startup). The formats
# taken, checked against the bytes themselves. A skill that needs a longer answer than a
# provider's max_tokens (a receipt's 40 drafts) says so in its SKILL.md (max-output-tokens).
AGENT_MAX_PHOTO_BYTES=1500000
AGENT_PHOTO_TYPES=image/jpeg,image/png,image/webp
AGENT_RUN_RETENTION_DAYS=7
AGENT_PROPOSAL_TTL_MINUTES=30
# Packages whose agents/ and skills/ folders are discovered (comma-separated).
AGENT_PACKAGES=app.platform
# Patterns removed from what is sent to an AI provider (a JSON list of regular expressions).
AGENT_REDACT_PATTERNS=["[\\w.+-]+@[\\w-]+(?:\\.[\\w-]+)*","\\+?\\d[\\d\\s-]{8,}\\d"]

# ---------------------------------------------------------------- DASHBOARD_ (ADR-0014)
# Days shown when the client sends no range, and the longest range it may ask for.
DASHBOARD_DEFAULT_RANGE_DAYS=30
DASHBOARD_MAX_RANGE_DAYS=366
# Seconds one widget may take before its card shows "couldn't load" instead.
DASHBOARD_WIDGET_TIMEOUT_SECONDS=3.0
# Days an activity entry is kept, and how many the "recent activity" widget shows.
DASHBOARD_ACTIVITY_RETENTION_DAYS=180
DASHBOARD_ACTIVITY_WIDGET_ITEMS=8

# ---------------------------------------------------------------- NOTIFICATIONS_
# Days a notification is kept before it is removed.
NOTIFICATIONS_RETENTION_DAYS=90

# ---------------------------------------------------------------- JOBS_ (ADR-0007)
# Shared secret of the jobs-cron workflow, sent as the X-Job-Token header to
# POST /v1/internal/jobs/{job}/run. Empty = that endpoint refuses every call (jobs still run
# when users open the app). 32+ printable ASCII characters, no spaces; generate one with:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(48))"
JOBS_TOKEN=
# Seconds a daily job's run holds its lease; a run that fails is retried after it. Must be
# longer than both time limits below.
JOBS_LEASE_SECONDS=300
# Seconds each job may take when the notification bell's poll runs it (the user waits),
# and when the cron does.
JOBS_LAZY_TIMEOUT_SECONDS=3.0
JOBS_RUN_TIMEOUT_SECONDS=20.0
# The cron catches up users signed in within this many days, at most this many per run.
JOBS_ACTIVE_DAYS=45
JOBS_MAX_USERS_PER_RUN=200
# Days a job's last-run record is kept after its last run.
JOBS_RETENTION_DAYS=30

# ---------------------------------------------------------------- REMINDERS_ (ADR-0012)
# Hour of the day (0-23, in the user's own time zone) at which a reminder is sent.
REMINDERS_SEND_HOUR=9
# Days a reminder is kept after its due day; a due date older than this is never scheduled.
REMINDERS_RETENTION_DAYS=90
# Longest snooze a user may ask for, in days (7 or more: the app offers up to a week).
REMINDERS_MAX_SNOOZE_DAYS=30
# Reminders sent per user each time jobs run; any others go out the next time.
REMINDERS_DELIVER_BATCH=50

# ---------------------------------------------------------------- SEARCH_
# Search from the command palette (GET /v1/search): queries shorter than min_chars find nothing;
# each module answers with at most max_hits things, within timeout_seconds or not at all.
SEARCH_MIN_CHARS=2
SEARCH_MAX_CHARS=80
SEARCH_MAX_HITS=8
SEARCH_TIMEOUT_SECONDS=2.0

# ---------------------------------------------------------------- FX_
# Exchange rates for entries in another currency (Frankfurter: free, no API key). Rates are kept
# in MongoDB per currency and day; today's are fetched again after FX_CACHE_TTL_HOURS.
FX_PROVIDER_URL=https://api.frankfurter.dev/v1
FX_CACHE_TTL_HOURS=12
FX_TIMEOUT_SECONDS=5.0

# ---------------------------------------------------------------- AUDIT_
# Days an audit entry (role changes, account changes, 2FA, allowlist, modules, export, delete)
# is kept.
AUDIT_RETENTION_DAYS=730

# ---------------------------------------------------------------- ADMIN_
# The admin console's usage pages: the database's size limit (Atlas M0: 512 MB), and days a
# day's count of each error code is kept.
ADMIN_DB_QUOTA_MB=512
ADMIN_ERROR_TALLY_DAYS=400
# Error counts are kept in memory and written at most this often, in seconds (0 = at once).
ADMIN_ERROR_TALLY_FLUSH_SECONDS=30
# The usage page's span when none is asked for, and the longest span it answers.
ADMIN_USAGE_DEFAULT_DAYS=30
ADMIN_USAGE_MAX_DAYS=366

# ---------------------------------------------------------------- PUSH_
# Web Push: reminders on a device even with the app closed (free; each user turns it on per
# browser). Off while the keys or the contact are empty. Make the key pair with `poe vapid-keys`
# and paste both from the same run (startup checks they fit); keep the private key secret.
# Changing the keys drops every browser subscribed with the old ones: users turn notifications
# on again.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
# How push services can reach whoever runs this server: mailto:you@example.com or https://...
PUSH_SUBJECT=
# Seconds a push service keeps a message for a device that is offline (at most 2419200).
PUSH_TTL_SECONDS=86400
# Seconds one round of pushes may take, every browser at once, and seconds one browser of it
# may take (shorter): a slower push service costs that browser's try and the round still
# finishes. Pushes go out in a job that claims them before the round and clears them after,
# so with push on, startup checks the round leaves those writes 0.5 seconds (the push job
# headroom, PUSH_JOB_HEADROOM_SECONDS in app/core/config.py): PUSH_TIMEOUT_SECONDS must be at
# most JOBS_LAZY_TIMEOUT_SECONDS - 0.5 and JOBS_RUN_TIMEOUT_SECONDS - 0.5.
PUSH_TIMEOUT_SECONDS=2.0
PUSH_DEVICE_TIMEOUT_SECONDS=1.5
# Pushes one round has under way at most (1-100). Each holds one of the shared HTTP client's
# 100 connections, which sign-in, the AI providers and other users' rounds use too, so keep
# it well below that. The rest wait their turn, which no browser's time counts; those still
# waiting when the round ends are not tried, and go again with the push's next try.
PUSH_MAX_PARALLEL=20
# Tries at pushing one reminder: a push not tried on every browser (the round cut short, the
# job's time limit, a restart) goes again after JOBS_LEASE_SECONDS, this many times in all.
PUSH_MAX_TRIES=3
# Browsers per account that receive pushes; past this the oldest is let go.
PUSH_MAX_SUBSCRIPTIONS=10
PUSH_VAPID_EXPIRY_HOURS=12
# Push services a browser's endpoint may be on (comma-separated host names, any case; hosts
# under them included). A scheme or a leading dot is dropped; a path, port or bare TLD stops
# startup.
PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,push.apple.com,notify.windows.com

# ---------------------------------------------------------------- BOOTSTRAP_ADMIN_
# First admin, created (or promoted) by `poe seed`. Leave empty to skip.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# ---------------------------------------------------------------- BACKUP_ (ADR-0019)
# `poe backup` / `poe restore`, run from your own machine (the server never uses these). Atlas
# M0 keeps no backups of its own. A backup holds everyone's data: keep it off shared drives.
# Folder the backups go in, one sub-folder each (relative to this project; git ignores it).
BACKUP_DIR=backups
# Fernet key that encrypts each backup: a key of its own, kept somewhere other than the
# backups (a password manager). Empty = plain files. Generate one with:
#   .venv\Scripts\python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
BACKUP_ENCRYPTION_KEY=
# Backups of the database kept; older ones are deleted after a new one is written.
BACKUP_KEEP=7
# Collections left out (comma-separated), e.g. caches that fill themselves again.
BACKUP_SKIP_COLLECTIONS=
# Documents written at a time when restoring.
BACKUP_RESTORE_BATCH=500

# ---------------------------------------------------------------- server (uvicorn)
# Read by `poe dev` and the Docker image. Render injects PORT automatically.
HOST=127.0.0.1
PORT=8000
# Proxies whose X-Forwarded-* headers uvicorn trusts. Render: "*", safe only together with
# SECURITY_PROXY_SECRET (every request then comes through the /api proxy, which sets
# X-Forwarded-For to the real client address).
FORWARDED_ALLOW_IPS=127.0.0.1

# ---------------------------------------------------------------- tests
# MongoDB server used by the test suite (a throwaway database is created and dropped).
TEST_MONGO_URI=mongodb://localhost:27017
