# For running the maintenance commands against the LIVE database from your own machine
# (docs/deployment.md): `poe seed`, `poe backup`, `poe restore`, `poe reset-password`.
#   copy environments\production.env.example environments\production.env   (git ignores it)
#   $env:APP_ENV = "production"; .venv\Scripts\poe backup; $env:APP_ENV = $null
# With APP_ENV=production the commands read .env, then this file (this file wins); each prints
# the host it works on before it starts. The server never reads this file: Render holds its
# settings. Keep only what the commands need here: never the real proxy secret.

APP_ENV=production
# The Atlas connection string. For backups the read-only user (tt-backup) is enough; seeding,
# restoring and password resets need the readWrite one (tt-api).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/tech-toppings-v1?retryWrites=true&w=majority

# Production refuses to start with weaker settings, so the commands need these to load. None
# of them is used here: the two secrets just need any 32+ characters (NOT Render's values).
APP_DOCS_ENABLED=false
LOG_FORMAT=json
SECURITY_HSTS_MAX_AGE_SECONDS=31536000
SECURITY_PROXY_SECRET=<any 32+ characters, not the real one>
AUTH_JWT_SECRET=<any 32+ characters>

# The first admin, for `poe seed`. Remove the password from this file once seeded.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Backups (`poe backup`): a folder of their own, apart from any local ones, and the key that
# encrypts them (required for a database that is not on this machine; keep the key in a
# password manager, not beside the backups).
BACKUP_DIR=backups/production
BACKUP_ENCRYPTION_KEY=
